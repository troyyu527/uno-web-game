# --- Optional: Cloudflare Worker (real cloud accounts, cross-device saves, online play)
#
# Leave this BLANK to use the built-in localStorage backend — single-player is
# fully functional with no setup. Set it to your deployed Worker's URL to switch
# to the cloud backend automatically (see README → "Server (Cloudflare)").
#
#   Deployed:  VITE_API_URL=https://uno-api.<your-subdomain>.workers.dev
#   Local:     VITE_API_URL=http://localhost:8787   (with `npm run api:dev`)
#
# The URL is public — the Worker authenticates every request itself.

VITE_API_URL=
