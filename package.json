{
  "name": "uno-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --base /uno-web-game/",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "test": "vitest run",
    "start": "vite",
    "api:dev": "wrangler dev -c worker/wrangler.toml",
    "api:deploy": "wrangler deploy -c worker/wrangler.toml",
    "db:migrate:local": "wrangler d1 execute uno --local --file worker/schema.sql -c worker/wrangler.toml",
    "db:migrate": "wrangler d1 execute uno --remote --file worker/schema.sql -c worker/wrangler.toml"
  },
  "dependencies": {
    "framer-motion": "^11.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.12",
    "typescript": "^5.5.4",
    "vite": "^5.4.6",
    "vitest": "^2.1.9",
    "wrangler": "^4.152.0"
  }
}
